# dashboard_admin — copia este archivo a .env y complétalo (nunca subas el .env)

# PostgreSQL del restaurante (Railway → pestaña Connect)
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Siempre 1 en el modelo deploy-por-restaurante (salvo que sepas por qué no)
RESTAURANTE_ID=1

# Contraseñas del panel: fuertes y DISTINTAS por restaurante.
# Los meseros no llevan contraseña: usan PIN de turno generado en Caja.
PANEL_PASSWORD_ADMIN=cambia-esta-contraseña
PANEL_PASSWORD_CAJA=cambia-esta-otra

# Opcionales (horas de vigencia de sesiones; valores por defecto razonables)
# MT_TOKEN_HORAS=18
# REMEMBER_HORAS=12
