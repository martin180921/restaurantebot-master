# whatsapp_bot — copia este archivo a .env y complétalo (nunca subas el .env)

# PostgreSQL del restaurante (Railway → pestaña Connect)
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Twilio (consola de Twilio → Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de WhatsApp aprobado, formato +57...
TWILIO_WHATSAPP_NUMBER=+573001234567

# URL pública del servicio app_cliente (el bot arma el enlace de la carta con esto)
APP_CLIENTE_URL=https://mi-restaurante-carta.up.railway.app

# Solo desarrollo local: "false" desactiva la validación de firma de Twilio
# TWILIO_VALIDATE=false
