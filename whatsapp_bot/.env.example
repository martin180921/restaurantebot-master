# whatsapp_bot — copia este archivo a .env y complétalo (nunca subas el .env)

# PostgreSQL del restaurante (Railway → pestaña Connect)
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# URL pública del servicio app_cliente (el bot arma el enlace de la carta con esto)
APP_CLIENTE_URL=https://mi-restaurante-carta.up.railway.app

# Cloud API de Meta (WhatsApp) — Meta for Developers → tu app → WhatsApp → API Setup
WA_TOKEN=              # token del system user (permanente)
WA_PHONE_NUMBER_ID=    # id del número, NO el número
WA_APP_SECRET=         # para validar X-Hub-Signature-256
WA_VERIFY_TOKEN=       # cadena inventada, para el GET de verificación del webhook
WA_API_VERSION=v23.0

# Solo desarrollo local: "false" desactiva la validación de X-Hub-Signature-256
# WA_VALIDATE=false
